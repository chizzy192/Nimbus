# =====================================================
# Nimbus · Environment Variables
# Copy to .env.local and fill in real values.
#
# DEMO MODE: if you leave the Supabase vars below blank, Nimbus boots in
# demo mode — every API call uses an in-memory store seeded with the three
# Kano / Abuja / Katsina farmers. No external services required.
# Set DEMO_MODE=true to force demo mode even when Supabase vars are set.
# =====================================================

# ---- Demo mode (optional) ----
# DEMO_MODE=true

# ---- Trustless Work ----
# Request an API key at https://dapp.trustlesswork.com
NEXT_PUBLIC_TW_API_KEY=
NEXT_PUBLIC_TW_BASE_URL=https://dev.api.trustlesswork.com

# ---- Stellar ----
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_RPC=https://soroban-testnet.stellar.org

# Platform / oracle wallet. Generate via `node -e "console.log(require('@stellar/stellar-sdk').Keypair.random().secret())"`
# Fund the public key with XLM via https://laboratory.stellar.org/#account-creator
PLATFORM_WALLET_PUBLIC=G...
PLATFORM_WALLET_SECRET=S...

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ---- Custodial wallet encryption ----
# 32-byte hex (64 chars) or base64 (44 chars). Generate via:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_ENCRYPTION_KEY=

# ---- Notifications (optional in dev) ----
RESEND_API_KEY=
TERMII_API_KEY=

# ---- Cron auth (production only) ----
# When set, /api/oracle/check requires either:
#   - Vercel's x-vercel-cron: 1 header (auto-set by Vercel Cron), OR
#   - Authorization: Bearer $CRON_SECRET for manual runs.
# In development this is bypassed automatically.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# ---- Open-Meteo ----
# No API key required. Free public endpoint.
